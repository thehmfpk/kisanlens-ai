# GROQ_API_KEY: Required for server-side Groq API inference (Vision & Multilingual Text).
# Keep this secret server-side only. Never prefix with VITE_.
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=""

# Optional: Override default Groq models if desired
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"

# GEMINI_API_KEY: Optional fallback injected by Google AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
